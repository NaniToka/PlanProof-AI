# ==============================================================================
# PlanProof AI - Environment Configuration Example
# Copy this file to .env and customize with your own values.
# NEVER commit .env to version control.
# ==============================================================================

# Application Metadata & Server
APP_NAME=PlanProof AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# AI Operation Mode (Options: auto, demo, gemini)
# - auto: Use Gemini when configured/available; otherwise use permitted deterministic fallbacks (default)
# - demo: Purely deterministic demo content; never calls Gemini
# - gemini: Requires Gemini for AI operations; errors when unconfigured/unavailable
AI_MODE=auto

# Google Gemini API Configuration
# Note: Verify the exact current model identifier in Google AI Studio
# GEMINI_API_KEY is optional during local development and testing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=3

# Dataset Storage Directory
DATA_DIR=data
# Optional path overrides:
# CRISIS_DATASET_PATH=data/crisis_scenarios.csv
# BUDGET_SPLITS_PATH=data/budget_splits.json
# VENDOR_CHECKLISTS_PATH=data/vendor_checklists.json

# Operational Limits
CACHE_TTL_SECONDS=3600
MAX_GUEST_COUNT=2000
MIN_EVENT_BUDGET_INR=10000
MAX_EVENT_BUDGET_INR=50000000
MAX_USER_TEXT_LENGTH=1000

# CORS Allowed Origins (wildcard or comma-separated URLs)
ALLOWED_CORS_ORIGINS=*
# ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Supabase & PostgreSQL Configuration (Optional for local offline use)
# Obtain these from your Supabase Project Settings -> API & Database:
#
# Client-Safe Public Variables (Exposed to browser via GET /api/v1/auth/config):
# - SUPABASE_URL: Project URL (https://<project-ref>.supabase.co, e.g. https://gtolvlwdipiqlqasatnf.supabase.co)
# - SUPABASE_ANON_KEY: Anonymous public API key (client-safe for official Supabase JS SDK)
#
# - APP_ENV: Environment mode: 'development', 'staging', 'production' (validation alias: ENVIRONMENT)
# - SUPABASE_JWT_SECRET: Project Settings -> API -> JWT Secret (only needed for legacy HS256 verification)
# - SUPABASE_JWT_AUDIENCE: Expected JWT aud claim (default: authenticated)
# - SUPABASE_JWT_ALGORITHMS: Allowed signing algorithms (default: HS256,RS256,ES256; pin to ES256 for ECC projects)
# - SUPABASE_JWT_PUBLIC_KEY: PEM-encoded RSA/ECDSA public key (for asymmetric verification)
# - SUPABASE_JWKS_URL: Explicit JWKS URL (derived automatically if SUPABASE_URL is provided)
# - SUPABASE_JWT_ISSUER: Expected JWT iss claim (derived automatically if SUPABASE_URL is provided)
# - ALLOW_GUEST_MODE: Enable in-memory guest sessions for local demos/offline use (default: true; disabled when postgres is active)
# - GUEST_SESSION_SECRET: Dedicated HMAC secret (min 32 chars) for guest sessions (required in production if guest mode enabled)
# - GUEST_SESSION_TTL_SECONDS: Guest session expiration TTL in seconds (default: 86400 = 24h)
# - TRUSTED_PROXIES: Comma-separated list of trusted reverse proxy IPs, CIDR blocks, or hostnames (e.g. 127.0.0.1,::1,10.0.0.0/8,testclient). Wildcards like 0.0.0.0/0 are prohibited.
# - SECURE_COOKIES: Explicit boolean override for Secure cookie attribute (default: True in production, False in dev unless verified HTTPS)
# - STORAGE_BACKEND: Event storage backend: 'memory' (default) or 'postgres'
# - DATABASE_URL: Runtime PostgreSQL connection pooler URI (Port 6543, NEVER client-accessible)
# - MIGRATION_DATABASE_URL: Direct PostgreSQL session URI (Port 5432) used ONLY for running DDL migrations
#
# Staging Supabase Configuration Example (ES256 Asymmetric Authentication):
# When SUPABASE_URL is set, JWKS endpoint (/auth/v1/.well-known/jwks.json) and Issuer (/auth/v1)
# are automatically derived by the backend. SUPABASE_JWT_SECRET is NOT needed for ES256.
#
# APP_ENV=staging
# SUPABASE_URL=https://gtolvlwdipiqlqasatnf.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ALGORITHMS=ES256
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://postgres.gtolvlwdipiqlqasatnf:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# MIGRATION_DATABASE_URL=postgresql://postgres.gtolvlwdipiqlqasatnf:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres



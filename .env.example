# ==============================================================================
# PlanProof AI - Environment Configuration Example
# Copy this file to .env and customize with your own values.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Google Gemini API (Required for later AI milestones; optional for Milestone 1)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Dataset Path Configuration
CRISIS_DATASET_PATH=data/crisis_scenarios.csv
BUDGET_SPLITS_PATH=data/budget_splits.json
VENDOR_CHECKLISTS_PATH=data/vendor_checklists.json
